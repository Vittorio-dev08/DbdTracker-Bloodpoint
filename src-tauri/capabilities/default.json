{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default", 
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}